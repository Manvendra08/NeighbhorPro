# --- Fix 1: src/lib/validation.ts ---
$file1 = "src\lib\validation.ts"
if (Test-Path $file1) {
    $content = Get-Content $file1 -Raw
    # Replace the fragile flatten() logic with the robust issue.path.join(".")
    $newContent = $content -replace '(?s)const formatted = error\.flatten\(.*?\);.*?const messages = Object\.entries\(formatted\.fieldErrors\).*?\..*?;', `
        'const messages = (error as z.ZodError<unknown>).issues.map((issue: z.ZodIssue) => `${issue.path.join(".")} : ${issue.message}`).join("; ");'
    
    # Fallback if the regex doesn't match the exact previous edit:
    if ($content -match "const messages = Object\.entries") {
        $content = $content -replace '(?s)const messages = Object\.entries\(formatted\.fieldErrors\)\s*\n\s*\.map\(\[field, errors\] => \$\{field\}: \$\{errors\?\.join.*?\}\)', `
            'const messages = Object.entries(formatted.fieldErrors).map(([field, errors]) => `${field}: ${(errors as string[])?.join(", ") ?? "Invalid"}`)'
    } else {
        # Just overwrite the problematic section if found
        $content = $content -replace '\.map\(\[field, errors\] => `.*?\.join.*?\)', `.map((issue: any) => \`\${issue.path.join('.')} : \${issue.message}\`)`
    }
    Set-Content $file1 -Value $newContent -NoNewline
    Write-Host "✅ Fixed src/lib/validation.ts" -ForegroundColor Green
} else { Write-Host "❌ File not found: $file1" -ForegroundColor Red }

# --- Fix 2: src/pages/admin/AdminUsers.bugfix.test.ts ---
$file2 = "src\pages\admin\AdminUsers.bugfix.test.ts"
if (Test-Path $file2) {
    $content = Get-Content $file2 -Raw
    
    # 1. Remove unused updateDoc
    $content = $content -replace 'import \{ updateDoc, getDocs,', 'import { getDocs,'
    
    # 2. Add mockDb definition if not present
    if ($content -notmatch "const mockDb = ") {
        $content = $content -replace '(describe\()', "const mockDb = {} as any;`n`$1"
    }
    
    # 3. Replace collection({}, ...) with collection(mockDb, ...)
    $content = $content -replace 'collection\(\{\}, ', 'collection(mockDb, '
    
    Set-Content $file2 -Value $content -NoNewline
    Write-Host "✅ Fixed src/pages/admin/AdminUsers.bugfix.test.ts" -ForegroundColor Green
} else { Write-Host "❌ File not found: $file2" -ForegroundColor Red }

# --- Verify Build ---
Write-Host "`n🚀 Attempting build..." -ForegroundColor Yellow
npm run build