# Copy this file to .env.local and fill in your values
# Firebase: Console → Project Settings → General
# Razorpay: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# FCM VAPID: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates

# Razorpay
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# Firebase — copy values from Firebase Console → Project Settings → General
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Cloudinary (for profile/booking image uploads)
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET


# FCM Web Push VAPID key (required for push notifications)
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web configuration → Key pair
VITE_FCM_VAPID_KEY=YOUR_FCM_VAPID_KEY

