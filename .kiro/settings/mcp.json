{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "autoApprove": [
        "browser_click",
        "browser_take_screenshot",
        "browser_navigate",
        "browser_snapshot",
        "browser_resize",
        "browser_console_messages",
        "browser_type",
        "browser_close"
      ]
    }
  },
  "powers": {
    "mcpServers": {
      "power-firebase-firebase-local": {
        "command": "npx",
        "args": [
          "-y",
          "firebase-tools@latest",
          "mcp"
        ]
      }
    }
  }
}