# Firebase service account key — NEVER commit
scripts/serviceAccountKey.json
.claude/settings.local.json

# Build artifacts
*.tsbuildinfo
tsconfig.tsbuildinfo

# Test output — generated, not source
coverage/
playwright-report/
test-results/

# Temporary / scratch dirs
tmp/
output/

# Binary / media assets — use Firebase Storage or Cloudinary instead
functions/*.jpeg
functions/*.jpg
functions/*.png
functions/*.gif
functions/*.pdf
functions/*.mp4
functions/*.webp
public/*.jpeg
public/*.jpg
public/*.png

# Root-level documents — keep locally, not in source control
*.pdf
*.docx
*.xlsx
*.pptx

# AI agent / IDE tool dirs
.agent/
.agent_backup/
_agent_backup/
.kiro/
.minimax/
