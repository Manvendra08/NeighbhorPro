rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Blocker #3: Fields that must NEVER be writable by the client directly.
    // role protects privilege escalation.
    function noSensitiveFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["role"]);
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      // Owners can update own profile and wallet balance, but NOT role
      allow update: if isSignedIn() && isOwner(userId) && noSensitiveFieldChange();
      // Admin can update anything including role (needed for adminAdjustCoins & role management)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.proId    == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        // Important #7: prevent self-booking
        && request.resource.data.clientId != request.resource.data.proId;
      allow update: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.proId    == request.auth.uid || isAdmin());
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Societies
    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Transactions (legacy)
    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // ── NeighbourCoins ─────────────────────────────

    // Coin ledger — immutable append-only entries
    match /coinLedger/{uid}/entries/{entryId} {
      allow read:          if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create:        if isSignedIn() && isOwner(uid);
      allow update, delete: if false;
    }

    // Support collectionGroup queries for Admin Dashboard
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }

    // Coin purchases — admin list for wallet dashboard
    match /coinPurchases/{purchaseId} {
      allow list:          if isAdmin();
      allow get:           if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create:        if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Coin payouts — admin list + owner create
    match /coinPayouts/{payoutId} {
      allow list:   if isAdmin();
      allow get:    if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Messages ───────────────────────────────────
    match /messages/{convId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /chats/{msgId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/messages/$(convId)).data.participants;
      }
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow read, update: if isSignedIn() &&
        (ticketId == "support_" + request.auth.uid || isAdmin());
      allow create: if isSignedIn() && ticketId == "support_" + request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() &&
          (ticketId == "support_" + request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }
  }
}
