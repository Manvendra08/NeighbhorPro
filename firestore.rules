rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function noSensitiveFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }
    // Validates a coinLedger entry written by the client (Path A — Spark plan).
    // Enforces: uid matches auth, amount is an integer, balanceAfter is non-negative.
    function validLedgerEntry(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.balanceAfter is int
        && request.resource.data.balanceAfter >= 0;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (
        (isOwner(userId) && (
          // Standard metadata/profile updates
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'residentVerificationStatus', 'verificationMethod']) ||
          // Specifically allow residency proof submission
          (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['residencyProofUrl', 'residentVerificationStatus']) &&
            request.resource.data.residentVerificationStatus == 'pending'
          )
        )) || 
        isAdmin()
      ) && noSensitiveFieldChange();
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.proId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId != request.resource.data.proId;
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.proId == request.auth.uid || isAdmin());
    }

    match /loyaltyStreaks/{streakId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isSignedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.proId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // FIX 2: Restored status == 'completed' guard to prevent review fabrication
    // on undelivered bookings.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed';
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // ── NeighbourCoins ──────────────────────────────────
    // FIX 1 (Path A — Spark plan): Client writes allowed with field-level validation.
    // Upgrade to Cloud Functions (Blaze) to lock this down further.
    // Entries are append-only: update and delete remain blocked.
    match /coinLedger/{uid}/entries/{entryId} {
      allow read:          if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create:        if isSignedIn() && isOwner(uid) && validLedgerEntry(uid);
      allow update, delete: if false;
    }
    // collectionGroup read for admin wallet dashboard — writes always blocked client-side.
    match /{path=**}/entries/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /coinPurchases/{purchaseId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /coinPayouts/{payoutId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Referrals ────────────────────────────────────────
    match /referrals/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isAdmin();
    }

    // ── Messages ─────────────────────────────────────────
    match /messages/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      match /chats/{msgId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messages/$(convId)).data.participants;
      }
    }

    // ── Support tickets (new collection) ─────────────────
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      match /messages/{msgId} {
        allow read, create: if isSignedIn() && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.uid == request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // ── Disputes ─────────────────────────────────────────
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.raisedByUid == request.auth.uid || resource.data.againstUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.raisedByUid == request.auth.uid;
      allow update: if isAdmin();
    }

    // ── FAQs ─────────────────────────────────────────────
    match /faqs/{faqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── App Settings ──────────────────────────────────────
    match /appSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Legacy support tickets ────────────────────────────
    match /supportTickets/{ticketId} {
      allow read, update: if isSignedIn() && (ticketId == "support_" + request.auth.uid || isAdmin());
      allow create: if isSignedIn() && ticketId == "support_" + request.auth.uid;
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (ticketId == "support_" + request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    match /localFeed/{postId} {
      // Locality-based visibility: only users in the same locality can read posts.
      // Posts without a locality field are visible to all signed-in users.
      allow read: if isSignedIn() && (
        !resource.data.keys().hasAny(['locality']) ||
        resource.data.locality == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.locality
      );
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // ── Activity Logs ─────────────────────────────────────
    // Users write their own events; only admins can read any log.
    // Update and delete are permanently blocked (append-only).
    match /activityLogs/{logId} {
      allow read:          if isAdmin();
      allow create:        if isSignedIn()
                             && request.resource.data.userId == request.auth.uid
                             && request.resource.data.keys().hasAll(['userId', 'event', 'details', 'timestamp'])
                             && request.resource.data.userId is string
                             && request.resource.data.event is string
                             && request.resource.data.details is string;
      allow update, delete: if false;
    }

    match /proAvailability/{proId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(proId);
    }
  }
}
