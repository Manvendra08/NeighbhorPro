rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }

    // Uses JWT Custom Claim — zero Firestore reads, no TOCTOU window.
    // Grant admin : node scripts/setAdminClaim.js <uid>  (Admin SDK, works on Spark)
    // Revoke admin: node scripts/setAdminClaim.js <uid> --revoke
    // Claim key is `admin` (bool), NOT `role` — consistent with setAdminClaim.js.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isFcmTokenOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
    }

    function isResidencyProofUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let uploadProof = request.resource.data.residencyProofUrl is string
        && request.resource.data.residentVerificationStatus == 'pending'
        && request.resource.data.verificationSubmittedAt != null;
      let deleteProof = resource.data.residentVerificationStatus != 'verified'
        && request.resource.data.residencyProofUrl == null
        && request.resource.data.residencyProofPreviewUrl == null
        && request.resource.data.residencyProofResourceType == null
        && request.resource.data.residentVerificationStatus == 'none'
        && request.resource.data.verificationSubmittedAt == null
        && changed.hasOnly([
          'residencyProofUrl', 'residencyProofPreviewUrl', 'residencyProofResourceType',
          'residentVerificationStatus', 'verificationMethod', 'verificationReviewNote',
          'verificationSubmittedAt', 'updatedAt'
        ]);
      return (uploadProof || deleteProof)
        && !changed.hasAny(['role', 'coinBalance', 'disabled', 'deleted', 'fcmToken', 'lastLedgerEntryId']);
    }

    function noSensitiveFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ["role", "coinBalance", "fcmToken", "disabled", "deleted", "lastLedgerEntryId"]
      );
    }

    function bookingClientId(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return ('clientId' in booking) ? booking.clientId : booking.clientUid;
    }

    function bookingProId(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return ('proId' in booking) ? booking.proId : booking.proUid;
    }

    function ownerServiceUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        "title", "description", "price", "isFree", "quoteBased",
        "duration", "category", "updatedAt"
      ])
      && request.resource.data.userId == resource.data.userId;
    }

    // [Fix #4] Added cashableBalance to allowed keys.
    // [Bug #2 FIX] Added promoBalance to allowed keys.
    // earnCoins() writes promoBalance alongside coinBalance for all PROMO_LEDGER_TYPES.
    // Without this, all client-side earn operations (profile, reviews, referrals,
    // milestones) silently fail for non-admin users.
    // [Bug #3 FIX] Added ALL LedgerType values to the allowlist.
    // Previously missing: earn_milestone, earn_groupsession, earn_ondemand,
    // admin_credit, admin_debit, subscription_debit, topup.
    function ownerWalletMutationAllowed(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let ledgerPath = /databases/$(database)/documents/coinLedger/$(userId)/entries/$(request.resource.data.lastLedgerEntryId);
      return changed.hasOnly(["coinBalance", "cashableBalance", "promoBalance", "updatedAt", "lastLedgerEntryId"])
        && request.resource.data.lastLedgerEntryId is string
        && request.resource.data.lastLedgerEntryId.size() > 0
        && request.resource.data.coinBalance is int
        && request.resource.data.coinBalance >= 0
        && (!('cashableBalance' in request.resource.data) || (
            request.resource.data.cashableBalance is int
            && request.resource.data.cashableBalance >= 0
        ))
        && (!('promoBalance' in request.resource.data) || (
            request.resource.data.promoBalance is int
            && request.resource.data.promoBalance >= 0
        ))
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.uid == userId
        && getAfter(ledgerPath).data.type in [
          'topup', 'booking_debit', 'booking_refund', 'booking_escrow',
          'booking_escrow_release', 'payout', 'payout_cancelled',
          'earn_signup_bonus', 'earn_profile', 'earn_referral',
          'earn_review', 'earn_free_consult', 'earn_milestone',
          'earn_groupsession', 'earn_ondemand',
          'admin_credit', 'admin_debit', 'subscription_debit'
        ]
        // CR-7 FIX: Verify ledger entry matches balance and is recent
        && getAfter(ledgerPath).data.balanceAfter == request.resource.data.coinBalance
        && getAfter(ledgerPath).data.uid == userId
        && getAfter(ledgerPath).data.createdAt > request.time - duration.time(1, 'm');
    }

    function bookingStatusTransitionAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["status", "updatedAt", "confirmedAt", "confirmedBy", "completedAt",
        "completedBy", "reviewedAt", "reviewedBy", "cancelledAt", "cancelledBy",
        "declinedAt", "declinedBy", "escrowStatus", "coinsPaid", "paidInCoins",
        "platformFee", "proEarning"])
        && (
          (resource.data.status == "pending"   && request.resource.data.status == "confirmed"  && request.auth.uid == resource.data.proId)
          || (resource.data.status == "pending"   && request.resource.data.status == "cancelled"  && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.proId))
          || (resource.data.status == "confirmed" && request.resource.data.status == "cancelled"  && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.proId))
          || (resource.data.status == "confirmed" && request.resource.data.status == "completed"  && request.auth.uid == resource.data.proId)
          || (resource.data.status == "completed" && request.resource.data.status == "reviewed"   && request.auth.uid == resource.data.clientId)
        );
    }

    function validUserDoc() {
      let data = request.resource.data;
      return (data.displayName is string && data.displayName.size() <= 100)
          && (!('email' in data) || (data.email is string))
          && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
          && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20));
    }

    // [Fix #6] Raised amount cap from ±5000 to ±10000.
    // Society pack yields 2500 + 500 bonus = 3000 coins in a single topup entry.
    // Any future pack above 5000 coins would have been silently rejected at ±5000.
    // ±10000 covers all current packs with headroom for expansion.
    function validLedgerEntry(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.type in [
          'topup', 'booking_debit', 'booking_refund', 'booking_escrow',
          'booking_escrow_release', 'payout', 'payout_cancelled',
          'earn_review', 'earn_referral', 'earn_free_consult', 'earn_profile',
          'earn_milestone', 'earn_groupsession', 'earn_ondemand', 'earn_signup_bonus',
          'admin_credit', 'admin_debit', 'subscription_debit'
        ]
        && request.resource.data.type is string
        && request.resource.data.description is string
        && request.resource.data.amount is int
        && request.resource.data.amount >= -10000
        && request.resource.data.amount <= 10000
        && request.resource.data.balanceAfter is int
        && request.resource.data.balanceAfter >= 0
        // CR-2 FIX: Check debit limit for subscription_debit type
        && (
          request.resource.data.type != "subscription_debit"
          || (
            request.resource.data.amount <= 0
            && -request.resource.data.amount <= getAfter(/databases/$(database)/documents/users/$(uid)).data.cashableBalance
          )
        );
    }

    function isBookingParticipant(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      let clientId = ('clientId' in booking) ? booking.clientId : booking.clientUid;
      let proId = ('proId' in booking) ? booking.proId : booking.proUid;
      return clientId == request.auth.uid || proId == request.auth.uid;
    }

    function conversationMatchesBooking(bookingId, participants) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      let clientId = ('clientId' in booking) ? booking.clientId : booking.clientUid;
      let proId = ('proId' in booking) ? booking.proId : booking.proUid;
      return participants is list
          && participants.size() == 2
          && participants.hasAll([clientId, proId])
          && participants.hasOnly([clientId, proId]);
    }

    // ── referralCodes ──────────────────────────────────────
    match /referralCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.code is string
        && request.resource.data.code.matches('^PN[A-Z0-9]{6}$');
      allow update, delete: if isAdmin();
    }

    // ── users ──────────────────────────────────────────────
    // [Task 4] Hardened: role and disabled fields are exclusively admin-writable.
    // noSensitiveFieldChange() already blocked role/coinBalance; adding explicit
    // hasAny(['role','disabled']) guard as defence-in-depth per task spec.
    match /users/{userId} {
      allow get:    if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list:   if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && validUserDoc() && request.resource.data.role == "user";
      allow update: if isAdmin()
                    || (
                      isSignedIn() && isOwner(userId)
                      // Block role and disabled mutations for non-admin owners.
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled'])
                      && (
                        isFcmTokenOnlyUpdate()
                        || isResidencyProofUpdate()
                        || (noSensitiveFieldChange() && validUserDoc())
                        || ownerWalletMutationAllowed(userId)
                        || (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialUsed', 'subscription', 'updatedAt'])
                          && request.resource.data.trialUsed == true
                          && request.resource.data.subscription.status == 'trial'
                          && request.resource.data.subscription.plan == 'business_trial_v1'
                        )
                      )
                    );
      allow delete: if isAdmin();
    }

    // ── publicProfiles ─────────────────────────────────────
    // Public-safe profile mirror — only the fields safe to expose to any neighbor.
    // Written by the owner on profile save; readable by anyone (no auth required) for Browse/ProDetail.
    // Sensitive fields (phone, flat, coinBalance, fcmToken, referralCode, role, disabled) are never written here by owners.
    match /publicProfiles/{userId} {
      allow list:   if true;
      allow read:   if true;
      allow create: if isSignedIn() && (
        (isOwner(userId)
          && !request.resource.data.keys().hasAny(['coinBalance', 'fcmToken', 'referralCode', 'role', 'disabled']))
        || isAdmin()
      );
      allow update: if isSignedIn() && (
        (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coinBalance', 'fcmToken', 'referralCode', 'role', 'disabled']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── services ───────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.description is string
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && (!(request.resource.data.category in ['Tuition & Coaching', 'Yoga & Fitness', 'Music & Dance', 'Language Classes', 'Nutrition & Diet'])
            || (
              'subscription' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status in ['trial','trial_ending','active','renewing','past_due','grace','comped']
            ));
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && ownerServiceUpdateAllowed())
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── bookings ───────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid
        || resource.data.proId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.clientId != request.resource.data.proId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.escrowCoins >= 0;
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          (resource.data.clientId == request.auth.uid || resource.data.proId == request.auth.uid)
          && bookingStatusTransitionAllowed()
        )
      );
    }

    // ── reviews ────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.bookingId is string
        && request.resource.data.proId is string
        && request.resource.data.clientId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.clientId == request.auth.uid
        && reviewId == request.resource.data.bookingId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && bookingClientId(request.resource.data.bookingId) == request.auth.uid
        && bookingProId(request.resource.data.bookingId) == request.resource.data.proId
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status in ['completed', 'reviewed'];
      allow update, delete: if isAdmin();
    }

    // ── residentReviews ────────────────────────────────────
    match /residentReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.bookingId is string
        && request.resource.data.clientId is string
        && request.resource.data.proId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && reviewId == request.resource.data.bookingId + '_' + request.auth.uid
        && ((('proId' in get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data)
              ? get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.proId
              : get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.proUid) == request.auth.uid)
        && ((('clientId' in get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data)
              ? get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId
              : get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientUid) == request.resource.data.clientId)
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status in ['completed', 'reviewed'];
      allow update, delete: if isAdmin();
    }

    // ── reports ────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
    }

    match /societies/{societyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // ── subscriptions ──────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin()
        || (request.resource.data.uid == request.auth.uid
            && request.resource.data.source == 'trial'
            && request.resource.data.plan == 'business_trial_v1'
            && request.resource.data.status == 'trial'
            && request.resource.data.currency == 'free'
            && request.resource.data.amount == 0)
      );
      // CR-4 FIX: Add rule validation for 30-day max trial duration
      allow update: if isAdmin() && (
        (!('source' in resource.data) || resource.data.source != 'trial')
        || (
          resource.data.source == 'trial'
          && request.resource.data.currentPeriodEnd.toMillis() <= 
             request.resource.data.currentPeriodStart.toMillis() + duration.time(30, 'd').toMillis()
        )
      );
      allow delete: if false;
    }

    match /subscriptionInvoices/{invId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin()
        || (request.resource.data.uid == request.auth.uid
            && request.resource.data.paymentMethod == 'trial'
            && request.resource.data.status == 'trial'
            && request.resource.data.currency == 'free'
            && request.resource.data.amount == 0)
      );
      allow update, delete: if false;
    }

    // ── NeighbourCoins ─────────────────────────────────────
    // [Task 4] coinLedger: users read own entries; admin reads all.
    // Direct client writes are blocked entirely — all mutations must
    // go through server-side transactions in the service layer.
    match /coinLedger/{uid}/entries/{entryId} {
      allow get:  if isSignedIn() && (isOwner(uid) || isAdmin());
      allow list: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow write: if false; // All writes via transactions only through service layer
    }
    // Wildcard catch-all for admin export reads across all sub-collections
    match /{path=**}/entries/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /coinPurchases/{purchaseId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── coinPayouts ────────────────────────────────────────
    // [Task 4] Only admin can set status to "processed" or "failed".
    // User may only self-cancel a pending payout; all monetary fields are locked.
    // [Fix #3] Added field validation to create rule: status must be "pending",
    // coinsRedeemed/amountRs must be integers in valid range, upiId must be present,
    // and processedBy/processedAt admin fields must not be pre-set by the user.
    match /coinPayouts/{payoutId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.coinsRedeemed is int
        && request.resource.data.coinsRedeemed >= 200
        && request.resource.data.coinsRedeemed <= 10000
        && request.resource.data.amountRs is int
        && request.resource.data.amountRs == request.resource.data.coinsRedeemed
        && request.resource.data.upiId is string
        && request.resource.data.upiId.size() > 0
        && request.resource.data.upiId.size() <= 100
        && !request.resource.data.keys().hasAny(['processedBy', 'processedAt']);
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.uid == request.auth.uid
                      && resource.data.status == "pending"
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.status == "cancelled_by_user"
                      && request.resource.data.coinsRedeemed == resource.data.coinsRedeemed
                      && request.resource.data.amountRs == resource.data.amountRs
                      && request.resource.data.upiId == resource.data.upiId
                      && request.resource.data.displayName == resource.data.displayName
                    );
      allow delete: if false;
    }

    // ── payoutLock ─────────────────────────────────────────
    // Sentinel documents used by requestPayout() to enforce at-most-one
    // pending payout per user via transactional tx.get() reads.
    // [Fix #1] All writes are service-layer only (runTransaction).
    match /payoutLock/{uid} {
      allow get:   if isSignedIn() && isOwner(uid);
      allow list:  if isAdmin();
      allow write: if false; // Service layer only via runTransaction
    }

    // ── Referrals ──────────────────────────────────────────
    match /referrals/{uid} {
      allow get:    if isSignedIn();
      allow list:   if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isAdmin();
    }

    // ── Messages ───────────────────────────────────────────
    match /messages/{convId} {
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow get:  if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (
        (isAdmin() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)
        || (
          request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.bookingId is string
          && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
          && isBookingParticipant(request.resource.data.bookingId)
          && conversationMatchesBooking(request.resource.data.bookingId, request.resource.data.participants)
        )
      );
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessage', 'lastMessageAt', 'lastSenderId',
             'participantNames', 'participantPhotos', 'bookingId', 'lastReadAt'
           ])
        && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt is map);
      match /chats/{msgId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messages/$(convId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(convId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // ── Support tickets ────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'subject', 'description', 'updatedAt'
             ])
        )
      );
      match /messages/{msgId} {
        allow read, create: if isSignedIn() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.uid == request.auth.uid
          || isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // ── Disputes ───────────────────────────────────────────
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.raisedByUid == request.auth.uid
        || resource.data.againstUid == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.raisedByUid == request.auth.uid
        && request.resource.data.status == 'raised'
        && request.resource.data.bookingId is string
        && isBookingParticipant(request.resource.data.bookingId);
      allow update: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Legacy support tickets ─────────────────────────────
    match /supportTickets/{ticketId} {
      allow read, update: if isSignedIn() && (ticketId == "support_" + request.auth.uid || isAdmin());
      allow create: if isSignedIn() && ticketId == "support_" + request.auth.uid;
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (ticketId == "support_" + request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // ── localFeed ──────────────────────────────────────────
    // [Fix #7] likeCount is now constrained to increment by exactly 1 per update.
    // The previous rule allowed any signed-in user to set likeCount to any int
    // 0–100000, making it trivially gameable. The new constraint ensures each
    // client update can only bump likeCount by 1 (decrement/admin path unchanged).
    match /localFeed/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'reactions', 'likes', 'likeCount', 'updatedAt'
           ])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.likeCount <= 100000
        && request.resource.data.likeCount == resource.data.likeCount + 1
      );
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── activityLogs ───────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'event', 'details', 'timestamp'])
        && request.resource.data.userId is string
        && request.resource.data.event is string
        && request.resource.data.details is string;
      allow update, delete: if false;
    }

    match /proAvailability/{proId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(proId);
    }
  }
}
